+    // ── Pre-warm (PERF-4) ─────────────────────────────────────────────
+
+    /// Build the next un-warmed screen's widget tree during idle so the
+    /// `lazy()` cache is populated before the user navigates. Called from
+    /// `AppMessage::IdleTick`; each call builds at most one screen so a
+    /// single idle tick never causes a perceptible frame hitch.
+    fn pre_warm_next_screen(&mut self) {
+        if self.prewarming {
+            return;
+        }
+        if !self.idle_timer.is_idle() {
+            return;
+        }
+        // Responsive mode is not part of the lazy cache keys, so pre-warmed
+        // trees built for another width band are stale — rebuild everything.
+        let mode = ResponsiveMode::of(self.window_width);
+        if self.prewarm_window_mode.is_some_and(|m| m != mode) {
+            self.prewarmed_screens.clear();
+        }
+        self.prewarm_window_mode = Some(mode);
+
+        let Some(screen) = PREWARM_ORDER
+            .iter()
+            .cloned()
+            .find(|s| !self.prewarmed_screens.contains(s))
+        else {
+            // All pre-warmable screens are already in the cache.
+            return;
+        };
+
+        // Building the Element (which internally calls `lazy(...)`) populates
+        // the cache; the tree itself is discarded.
+        self.prewarming = true;
+        let element = self.build_screen_element(screen.clone());
+        drop(element);
+        self.prewarmed_screens.push(screen);
+        self.prewarming = false;
+    }
+
+    /// Build the widget tree for a pre-warmable screen, mirroring the same
+    /// view functions the main `view()` dispatches to.
+    fn build_screen_element(&self, screen: Screen) -> iced::Element<'_, AppMessage> {
+        match screen {
+            Screen::FileSharing => self.view_file_sharing(),
+            Screen::Settings => self.view_settings_screen(),
+            Screen::Discover => self.view_discover(),
+            Screen::Groups => self.view_sidebar_groups(),
+            Screen::FriendRequests => self.view_friend_requests(),
+            // PREWARM_ORDER only ever contains the parameterless screens
+            // above; anything else would be a programming error.
+            _ => unreachable!("build_screen_element called for a non-prewarmable screen"),
+        }
+    }
+
+    /// Forget pre-warmed screens whose dependency would have changed, so the
+    /// next idle cycle rebuilds them with fresh state. `screens` is the set
+    /// of affected screens; pass `PREWARM_ORDER` to invalidate everything
+    /// (dark-mode toggle, responsive breakpoint crossing).
+    fn invalidate_prewarm(&mut self, screens: &[Screen]) {
+        self.prewarmed_screens.retain(|s| !screens.contains(s));
+    }
